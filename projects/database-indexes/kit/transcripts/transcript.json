			},
			"offsets": {
				"from": 145480,
				"to": 148680
			},
			"text": " Now it sees Alice@email.com."
		},
		{
			"timestamps": {
				"from": "00:02:28,680",
				"to": "00:02:31,120"
			},
			"offsets": {
				"from": 148680,
				"to": 151120
			},
			"text": " Bob comes after Alice, so it moves to the right."
		},
		{
			"timestamps": {
				"from": "00:02:31,120",
				"to": "00:02:35,840"
			},
			"offsets": {
				"from": 151120,
				"to": 155840
			},
			"text": " And it keeps moving strategically like this until it finds bob@email.com in the index."
		},
		{
			"timestamps": {
				"from": "00:02:35,840",
				"to": "00:02:40,760"
			},
			"offsets": {
				"from": 155840,
				"to": 160760
			},
			"text": " Bob's entry in the index has a pointer to where Bob's row is in the table."
		},
		{
