			},
			"offsets": {
				"from": 0,
				"to": 24400
			},
			"text": " As you get more users, your database grows and your tables get bigger."
		},
		{
			"timestamps": {
				"from": "00:00:24,400",
				"to": "00:00:28,000"
			},
			"offsets": {
				"from": 24400,
				"to": 28000
			},
			"text": " Now it might take a little bit longer for your app to load and you're now having performance"
		},
		{
			"timestamps": {
				"from": "00:00:28,000",
				"to": "00:00:29,120"
			},
			"offsets": {
				"from": 28000,
				"to": 29120
			},
			"text": " issues."
		},
		{
			"timestamps": {
				"from": "00:00:29,120",
				"to": "00:00:32,480"
			},
			"offsets": {
				"from": 29120,
				"to": 32480
			},
			"text": " One thing that you can always use to fix this is a database index."
		},
		{
			"timestamps": {
				"from": "00:00:32,480",
				"to": "00:00:37,180"
			},
			"offsets": {
				"from": 32480,
				"to": 37180
			},
			"text": " In this video, we'll go over what your database does when there is no index, what an index"
		},
		{
			"timestamps": {
				"from": "00:00:37,180",
				"to": "00:00:41,880"
			},
			"offsets": {
				"from": 37180,
				"to": 41880
			},
			"text": " actually is, how it helps find things so fast and helps performance, and the different types"
		},
		{
			"timestamps": {
				"from": "00:00:41,880",
				"to": "00:00:46,640"
			},
			"offsets": {
				"from": 41880,
				"to": 46640
			},
			"text": " of indexes, the mistakes that people make when they use database indexes."
		},
		{
			"timestamps": {
				"from": "00:00:46,640",
				"to": "00:00:50,280"
			},
			"offsets": {
				"from": 46640,
				"to": 50280
			},
			"text": " So understand why a database index matters, especially for performance."
		},
		{
			"timestamps": {
				"from": "00:00:50,280",
				"to": "00:00:54,040"
			},
			"offsets": {
				"from": 50280,
				"to": 54040
			},
			"text": " You first have to understand what your database does without an index."
		},
		{
			"timestamps": {
				"from": "00:00:54,040",
				"to": "00:00:59,160"
			},
			"offsets": {
				"from": 54040,
				"to": 59160
			},
			"text": " Here we have a bookstores and the bookstable in our database has a million rows."
		},
		{
			"timestamps": {
				"from": "00:00:59,160",
				"to": "00:01:03,120"
			},
			"offsets": {
				"from": 59160,
				"to": 63120
			},
			"text": " We have a million books in there and we run this query."
		},
		{
			"timestamps": {
				"from": "00:01:03,120",
				"to": "00:01:07,380"
			},
			"offsets": {
				"from": 63120,
				"to": 67380
			},
			"text": " Without an index, the database has no idea where Auto42's books are."
		},
		{
			"timestamps": {
				"from": "00:01:07,380",
				"to": "00:01:09,120"
			},
			"offsets": {
				"from": 67380,
				"to": 69120
			},
			"text": " So it does the only thing it can do."
		},
		{
			"timestamps": {
				"from": "00:01:09,120",
				"to": "00:01:14,360"
			},
			"offsets": {
				"from": 69120,
				"to": 74360
			},
			"text": " It starts as the first row and it checks every single row, all one million of them, and that"
		},
		{
			"timestamps": {
				"from": "00:01:14,360",
				"to": "00:01:16,840"
			},
			"offsets": {
				"from": 74360,
				"to": 76840
			},
			"text": " is called a full table scan."
		},
		{
			"timestamps": {
				"from": "00:01:16,840",
				"to": "00:01:19,840"
			},
			"offsets": {
				"from": 76840,
				"to": 79840
			},
			"text": " And in many cases, it can be very problematic."
		},
		{
			"timestamps": {
				"from": "00:01:19,840",
				"to": "00:01:23,920"
			},
			"offsets": {
				"from": 79840,
				"to": 83920
			},
			"text": " When your table has maybe 10, 100 rows, maybe it wouldn't be a problem."
		},
		{
			"timestamps": {
				"from": "00:01:23,920",
				"to": "00:01:28,160"
			},
			"offsets": {
				"from": 83920,
				"to": 88160
			},
			"text": " Maybe you wouldn't notice, but at a million rows, then it's a problem."
		},
		{
			"timestamps": {
				"from": "00:01:28,160",
				"to": "00:01:29,800"
			},
			"offsets": {
				"from": 88160,
				"to": 89800
			},
			"text": " What is a database index?"
		},
		{
			"timestamps": {
				"from": "00:01:29,800",
				"to": "00:01:32,840"
			},
			"offsets": {
				"from": 89800,
				"to": 92840
			},
			"text": " And how does it solve this problem of speed and performance?"
		},
		{
			"timestamps": {
				"from": "00:01:32,840",
				"to": "00:01:36,200"
			},
			"offsets": {
				"from": 92840,
				"to": 96200
			},
			"text": " The easiest way to think about it is the index at the back of a book."
		},
		{
			"timestamps": {
				"from": "00:01:36,200",
				"to": "00:01:39,320"
			},
			"offsets": {
				"from": 96200,
				"to": 99320
			},
			"text": " If you want to find every page that mentions a particular word, you don't read the old"
		},
		{
			"timestamps": {
				"from": "00:01:39,320",
				"to": "00:01:40,320"
			},
			"offsets": {
				"from": 99320,
				"to": 100320
			},
			"text": " book from the beginning."
		},
		{
			"timestamps": {
				"from": "00:01:40,320",
				"to": "00:01:44,520"
			},
			"offsets": {
				"from": 100320,
				"to": 104520
			},
			"text": " You go to the index at the back, it's sorted alphabetically, you find the word and it tells"
		},
		{
			"timestamps": {
				"from": "00:01:44,520",
				"to": "00:01:45,760"
			},
			"offsets": {
				"from": 104520,
				"to": 105760
			},
			"text": " you the page number."
		},
		{
			"timestamps": {
				"from": "00:01:45,760",
				"to": "00:01:48,400"
			},
			"offsets": {
				"from": 105760,
				"to": 108400
			},
			"text": " A database index works the same way."
		},
		{
			"timestamps": {
				"from": "00:01:48,400",
				"to": "00:01:53,560"
			},
			"offsets": {
				"from": 108400,
				"to": 113560
			},
			"text": " It's a separate structure that starts the value from a column in sorted order."
		},
		{
			"timestamps": {
				"from": "00:01:53,560",
				"to": "00:01:57,120"
			},
			"offsets": {
				"from": 113560,
				"to": 117120
			},
			"text": " And for each value, it keeps a pointer to where that row actually lives."
		},
		{
			"timestamps": {
				"from": "00:01:57,120",
				"to": "00:02:02,040"
			},
			"offsets": {
				"from": 117120,
				"to": 122040
			},
			"text": " And it only stores the column and the pointer, so it's way much more smaller than the table"
		},
		{
			"timestamps": {
				"from": "00:02:02,040",
				"to": "00:02:03,040"
			},
			"offsets": {
				"from": 122040,
				"to": 123040
			},
			"text": " itself."
		},
		{
			"timestamps": {
				"from": "00:02:03,040",
				"to": "00:02:06,320"
			},
			"offsets": {
				"from": 123040,
				"to": 126320
			},
			"text": " Now, what mechanism does a database index use to find things so fast?"
		},
		{
			"timestamps": {
				"from": "00:02:06,320",
				"to": "00:02:10,160"
			},
			"offsets": {
				"from": 126320,
				"to": 130160
			},
			"text": " I read an article on this and I love the way the writer explained it and I'm going to use"
		},
		{
			"timestamps": {
				"from": "00:02:10,160",
				"to": "00:02:11,160"
			},
			"offsets": {
				"from": 130160,
				"to": 131160
			},
			"text": " the example."
