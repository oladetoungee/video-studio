		{
			"timestamps": {
				"from": "00:02:11,160",
				"to": "00:02:13,000"
			},
			"offsets": {
				"from": 131160,
				"to": 133000
			},
			"text": " I will link the article in the description box as well."
		},
		{
			"timestamps": {
				"from": "00:02:13,000",
				"to": "00:02:17,160"
			},
			"offsets": {
				"from": 133000,
				"to": 137160
			},
			"text": " Say you have an index on the email column and you're looking for bob@email.com."
		},
		{
