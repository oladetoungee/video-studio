				"to": "00:03:36,400"
			},
			"offsets": {
				"from": 215400,
				"to": 216400
			},
			"text": " You can ask the database."
		},
		{
			"timestamps": {
				"from": "00:03:36,400",
				"to": "00:03:39,600"
			},
			"offsets": {
				"from": 216400,
				"to": 219600
			},
			"text": " Just put the word \"splain\" in front of your query."
		},
		{
