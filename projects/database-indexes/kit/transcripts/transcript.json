			},
			"offsets": {
				"from": 160760,
				"to": 164800
			},
			"text": " So with this strategy, even with a million rows, you can get to the row you're looking"
		},
		{
			"timestamps": {
				"from": "00:02:44,800",
				"to": "00:02:47,920"
			},
			"offsets": {
				"from": 164800,
				"to": 167920
			},
			"text": " for in about 20 steps or so."
		},
		{
			"timestamps": {
				"from": "00:02:47,920",
