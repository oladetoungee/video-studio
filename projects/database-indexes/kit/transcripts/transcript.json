		{
			"timestamps": {
				"from": "00:03:10,920",
				"to": "00:03:14,880"
			},
			"offsets": {
				"from": 190920,
				"to": 194880
			},
			"text": " Adding a database query will literally up your query optimization goal."
		},
		{
			"timestamps": {
				"from": "00:03:14,880",
				"to": "00:03:16,320"
			},
			"offsets": {
				"from": 194880,
				"to": 196320
			},
			"text": " And it's kind of a one-liner."
		},
		{
			"timestamps": {
				"from": "00:03:16,320",
				"to": "00:03:17,720"
			},
			"offsets": {
				"from": 196320,
				"to": 197720
			},
			"text": " In SKA, it looks something like this."
		},
		{
			"timestamps": {
				"from": "00:03:17,720",
				"to": "00:03:21,760"
			},
			"offsets": {
				"from": 197720,
				"to": 201760
			},
			"text": " If you're using Laravel, you're using Laravel for the past one year, for example, you simply"
		},
