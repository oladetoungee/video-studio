				"from": "00:02:17,160",
				"to": "00:02:22,280"
			},
			"offsets": {
				"from": 137160,
				"to": 142280
			},
			"text": " The database opens the index in the middle and maybe sees dave@email.com."
		},
		{
			"timestamps": {
				"from": "00:02:22,280",
				"to": "00:02:23,520"
			},
			"offsets": {
				"from": 142280,
				"to": 143520
			},
			"text": " Bob comes before dave."
		},
		{
			"timestamps": {
				"from": "00:02:23,520",
				"to": "00:02:25,480"
			},
			"offsets": {
				"from": 143520,
				"to": 145480
			},
			"text": " So it moves to the left."
		},
		{
			"timestamps": {
				"from": "00:02:25,480",
